generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//ENUMS
enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  INACTIVE
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum Department {
  // Engineering & Technology
  COMPUTER_SCIENCE
  INFORMATION_TECHNOLOGY
  SOFTWARE_ENGINEERING
  ENGINEERING
  ARCHITECTURE

  // Business & Economics
  BUSINESS_ADMINISTRATION
  ACCOUNTING
  FINANCE
  ECONOMICS
  MARKETING
  HUMAN_RESOURCE_MANAGEMENT

  // Health & Medicine
  MEDICINE
  NURSING
  PHARMACY
  DENTISTRY
  PUBLIC_HEALTH
}

enum DegreeType {
  BACHELORS
  MASTERS
  PHD
}

enum CourseStatus {
  ACTIVE
  ARCHIVED
}

enum Semester {
  SEMESTER_1
  SEMESTER_2
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum EnrollmentStatus {
  ONGOING
  COMPLETED
  DROPPED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum AttendanceMethod {
  MANUAL
  FACIAL_RECOGNITION
  SYSTEM
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
}

enum PasswordTokenUserType {
  ADMIN
  LECTURER
  STUDENT
}

enum PasswordTokenPurpose {
  WELCOME_SETUP
  PASSWORD_RESET
}

//TABLES

model Admin {
  id            String        @id @default(uuid())
  firstName     String
  lastName      String
  email         String        @unique
  password      String
  phoneNumber   String        @unique
  dateOfBirth   DateTime      @db.Date
  role          AdminRole     @default(ADMIN)
  accountStatus AccountStatus @default(PENDING_ACTIVATION)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  authVersion Int @default(0)
}

//Student
model Student {
  id             String   @id @default(uuid())
  studentId      String   @unique
  firstName      String
  lastName       String
  email          String   @unique
  password       String
  phoneNumber    String   @unique
  dateOfBirth    DateTime @db.Date
  enrollmentYear Int

  majorId     String
  major       Major        @relation(fields: [majorId], references: [id])
  enrollments Enrollment[]

  attendanceRecords AttendanceRecord[]

  accountStatus  AccountStatus @default(PENDING_ACTIVATION)
  faceRegistered Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  authVersion Int @default(0)
}

//Lecturer
model Lecturer {
  id            String        @id @default(uuid())
  lecturerId    String        @unique
  firstName     String
  lastName      String
  email         String        @unique
  password      String
  phoneNumber   String        @unique
  dateOfBirth   DateTime      @db.Date
  department    Department
  accountStatus AccountStatus @default(PENDING_ACTIVATION)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  classes     Class[]
  authVersion Int     @default(0)
}

//Major
model Major {
  id         String     @id @default(uuid())
  majorCode  String     @unique
  majorName  String
  department Department
  degreeType DegreeType
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  students Student[]
  courses  Course[]
}

model Course {
  id           String       @id @default(uuid())
  courseCode   String       @unique
  courseName   String
  description  String?
  creditPoints Int
  status       CourseStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  majors  Major[]
  classes Class[]

  prerequisites CoursePrerequisite[] @relation("CoursePrerequisites")
  requiredFor   CoursePrerequisite[] @relation("PrerequisiteFor")
}

model CoursePrerequisite {
  id String @id @default(uuid())

  courseId             String
  prerequisiteCourseId String

  course Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)

  prerequisiteCourse Course @relation("PrerequisiteFor", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteCourseId])
}

model AcademicTerm {
  id        String   @id @default(uuid())
  semester  Semester
  year      Int
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  classes Class[]

  @@unique([semester, year])
}

model Class {
  id        String @id @default(uuid())
  classCode String

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  lecturerId String
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id])

  academicTermId String
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id])

  scheduleDays DayOfWeek[]
  startTime    DateTime    @db.Time
  endTime      DateTime    @db.Time

  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]

  room        String
  maxCapacity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classCode, academicTermId])
}

model Enrollment {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  status EnrollmentStatus @default(ONGOING)

  enrolledAt DateTime  @default(now())
  droppedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, classId])
}

model AttendanceSession {
  id String @id @default(uuid())

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  status AttendanceSessionStatus @default(OPEN)

  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  occurrenceDate DateTime  @db.Date

  records AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, occurrenceDate])
}

model AttendanceRecord {
  id String @id @default(uuid())

  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String

  student Student @relation(fields: [studentId], references: [id])

  status AttendanceStatus
  method AttendanceMethod

  markedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
}

//FOR PASSWORD RESET PURPOSE
model PasswordToken {
  id        String @id @default(uuid())
  tokenHash String @unique

  userId   String
  userType PasswordTokenUserType
  purpose  PasswordTokenPurpose

  expiresAt DateTime
  usedAt    DateTime?

  requestedByAdminId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, userType])
  @@index([userId, userType, createdAt])
  @@index([expiresAt])
}
